{
  "name": "pepcalculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first dose calculator that turns a desired mg/mcg dose into the volume and insulin units to draw, for peptides and anabolic oils.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "server": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "server:watch": "node --watch --disable-warning=ExperimentalWarning server/server.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/generate-og.mjs",
    "vapid": "node scripts/generate-vapid.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
