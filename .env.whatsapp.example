# The WhatsApp reminder stack — copy to `.env` and fill every value in.
#
#   cd /var/www/pepcalculator
#   cp .env.whatsapp.example .env
#
# This one file drives **both** compose files: the Evolution stack reads the
# Postgres password and the API key from it, and the sync server reads the key,
# the webhook secret and the phone number from it. Nothing has to be written
# down twice.
#
# Never commit the filled-in `.env` (it is already in `.gitignore`).

# The API key the two services share. Evolution calls it
# `AUTHENTICATION_API_KEY`; the sync server calls it `WHATSAPP_API_KEY`.
# Generate with:  openssl rand -hex 32
WHATSAPP_API_KEY=

# The Postgres password, used only inside the compose network.
# Generate with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# The webhook secret. Generate with:  openssl rand -hex 32
#
# Written **once** here. The webhook path is built from it, and the sync server
# checks the same value — so the two sides cannot drift apart.
WHATSAPP_WEBHOOK_SECRET=

# The instance name. Created once, then linked by scanning a QR code.
WHATSAPP_INSTANCE=pepstool

# The number reminders go **from**, digits only: no `+`, no spaces.
# This is the public number behind the `wa.me` link the user taps.
WHATSAPP_NUMBER=

# Where "your plans" points, in the help text a subscriber gets back.
MANAGE_URL=https://pepstool.com

# Optional. Set only if the sync server is not reachable as `sync:8787` on the
# shared docker network — a public HTTPS address, secret path included.
# WEBHOOK_URL=

# Optional. Where a dropped WhatsApp link is announced. Empty means the server
# logs it loudly and carries on.
# ALERT_WEBHOOK_URL=

