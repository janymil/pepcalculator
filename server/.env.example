# Server-side environment for `server/server.mjs`.
#
# There are no secrets here that the *client* needs: the VAPID public key is
# served to the app from `GET /api/push/pubkey`, and the app never sends the sync
# code itself (only its SHA-256 hash). Load these however you prefer — your host's
# dashboard, docker-compose, or `node --env-file=server/.env server/server.mjs`.

# Where the SQLite database lives. Put it on a persistent volume in production.
# DB_PATH=/data/sync.sqlite

# The exact origin the app is served from. Accepts a comma-separated list.
ALLOWED_ORIGIN=https://your-app.example

# Web Push — generate with `npm run vapid`. Push stays off until BOTH keys are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often the scheduler looks for a due dose (milliseconds).
# PUSH_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# WhatsApp reminders (optional, and off by default)
# ---------------------------------------------------------------------------
#
# Sending stays off until WHATSAPP_URL, WHATSAPP_API_KEY and WHATSAPP_INSTANCE
# are all set, so a server with none of this behaves exactly as it did before.
#
# Read `PROPOSAL-whatsapp-reminders.md` first. Evolution API is an *unofficial*
# WhatsApp client: the number can be banned, permanently and without appeal.
# Web Push is the default channel for that reason.
#
# Put the Evolution stack up with:
#   docker compose -f docker-compose.whatsapp.yml up -d

# Where Evolution listens. Bound to loopback by the compose file on purpose.
# WHATSAPP_URL=http://127.0.0.1:8080

# The instance's API key — AUTHENTICATION_API_KEY in the Evolution stack.
# WHATSAPP_API_KEY=

# The instance name, created once and then linked by QR code.
# WHATSAPP_INSTANCE=pepstool

# Evolution's v1 and v2 have used different paths. Check the instance's own
# /docs and set this rather than trusting the default, including this one.
# WHATSAPP_SEND_PATH=/message/sendText/{instance}

# The webhook secret, in the path AND in the `apikey` header — both are checked.
#
# This one is not optional in practice. The CORS guard accepts a request with no
# `Origin` header, and Evolution sends none, so without this anyone who learns
# the path could fake a STOP for any number. Generate with:
#   openssl rand -hex 32
# WHATSAPP_WEBHOOK_SECRET=

# The public number behind the `wa.me` link. Digits only: no `+`, no spaces.
# Without it the app has no link to show, and PUT /api/wa/:key answers 503.
# WHATSAPP_NUMBER=421900000000

# How often the worker looks for a due reminder (milliseconds).
# WHATSAPP_INTERVAL_MS=30000

# Requests per address per window on the webhook. Its own budget, so a flood at
# the app can never starve the webhook. 0 disables the limit.
# WHATSAPP_WEBHOOK_RATE_LIMIT=60

# Where "your plans" points, in the help text a subscriber gets back.
# MANAGE_URL=https://pepstool.com

# Where a dropped WhatsApp link is announced. Optional, and empty by default —
# then the server logs a loud warning and carries on.
#
# There is no destination it can invent for itself: the alert is *about*
# WhatsApp being down, so it cannot be sent over WhatsApp. Point this at
# anything you already watch. It receives `{"text": "Pepstool WhatsApp: ..."}`.
# ALERT_WEBHOOK_URL=
#
# The link's own state is also reported in the health check, whether this is set
# or not, because "nobody is due" and "the whole channel is dead" look identical
# from the outside:
#
#   curl -s localhost:8787/api/health
#   {"ok":true,"whatsapp":{"state":"open","since":"...","reason":null,"sending":true}}

